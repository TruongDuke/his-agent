# === Model (chọn 1 trong 2) ===

# Cách 1 — OpenRouter (dùng key có sẵn từ Platform-HIS)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-haiku-4-5   # hoặc qwen/qwen3-30b, openai/gpt-4o-mini

# Cách 2 — Anthropic trực tiếp
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Aidbox FHIR R5 ===
AIDBOX_URL=https://your-instance.edge.aidbox.app
AIDBOX_CLIENT_ID=your-client-id
AIDBOX_CLIENT_SECRET=your-client-secret

# === Gmail (tùy chọn) ===
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=Bệnh viện Đa khoa Hà Nội

# === Cổng tiếp nhận dữ liệu từ HIS bệnh viện (tùy chọn) ===
# Chưa đặt → toàn bộ /api/his/* đóng, trả 503. Đặt rồi thì bên HIS phải gửi
# đúng giá trị này qua header X-HIS-API-Key.
HIS_API_KEY=
